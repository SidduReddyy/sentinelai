SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite:///./sentinelai.db

# AI Provider (optional — leave blank to use local fallback)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Admin setup (used only on first run to create initial admin)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_EMAIL=admin@sentinelai.local

# Detection thresholds
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=300
ACCESS_DENIED_THRESHOLD=10
ACCESS_DENIED_WINDOW_SECONDS=300
EVENT_BURST_THRESHOLD=50
EVENT_BURST_WINDOW_SECONDS=60

# Server
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501
